# PermaDrive script environment variables. Copy to .env and fill in (.env is gitignored, never commit).
# Scripts under scripts/p2 and scripts/p3 fall back to reading scripts/poc/.env when the env var is unset.

# Substrate mnemonic (12/24 words). Generate a new account: cd scripts/poc && npm run gen-account
# Mainnet ss58 prefix is 6094 (addresses start with su…); the same mnemonic derives the Auto-EVM
# account via BIP44 m/44'/60'/0'/0/0.
CHAIN_MNEMONIC=

# Optional: override default endpoints / throttle intervals (defaults in scripts/poc/lib/chain.mjs)
# CHAIN_RPC=https://rpc.mainnet.subspace.foundation/ws
# CHAIN_INDEXER=wss://indexer.mainnet.autonomys.xyz/ws
# RPC_MIN_INTERVAL_MS=1600
# BATCH_MIN_INTERVAL_MS=1400
